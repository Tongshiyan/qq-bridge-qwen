# pnpm configuration for this project.
#
# WHY node-linker=hoisted:
#   pnpm's default isolated layout puts real packages under node_modules/.pnpm
#   and links them with junctions. DSH's bundled Node runs from inside
#   app.asar (file:///D:/dsh/resources/app.asar/...), and its ESM resolver
#   fails to walk through those junctions to find transitive deps such as
#   `ws` -- error:
#     Cannot find package 'ws' imported from .../qqbot-nodejs/dist/protocol/
#     gateway/gateway-connection.js
#   A flat, npm-style node_modules tree avoids junction traversal entirely.
node-linker=hoisted

# Keep the store inside the project so nothing is written outside the
# workspace (which the DSH file sandbox would block).
store-dir=.pnpm-store
